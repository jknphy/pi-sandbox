FROM opensuse/tumbleweed

# Install system dependencies required by Pi for tools, skills, and extensions,
# plus mkmedia/xorriso for the modify-iso skill (SUSE-only packages, hence the
# openSUSE base instead of Debian).
RUN zypper --non-interactive install --no-recommends \
      bash ca-certificates curl git ripgrep python3 jq \
      nodejs-default npm-default \
      mkmedia xorriso openQA-client vim fd gh \
      which bubblewrap socat \
  && zypper clean --all

# SUSE internal CA (openqa.suse.de etc.)
RUN zypper --non-interactive addrepo -r https://download.opensuse.org/repositories/SUSE:/CA/openSUSE_Tumbleweed/SUSE:CA.repo \
  && zypper --non-interactive --gpg-auto-import-keys install --no-recommends ca-certificates-suse \
  && zypper clean --all
# Node uses its own bundled CA list, not the system one
ENV NODE_EXTRA_CA_CERTS=/etc/ssl/ca-bundle.pem

# Install Pi coding agent globally
RUN npm install -g @earendil-works/pi-coding-agent

# Host ~/.pi/agent is deliberately not mounted (auth.json, sessions); state lives in the pi-agent-home volume.
# Own config (skills, prompts, settings, permission-mode.json) is mounted ro; edit it from a pi-sandbox run in this repo.
WORKDIR /workspace
ENTRYPOINT ["pi"]
