#!/usr/bin/env bash

# ~/.local/bin/pi-sandbox
#   pi-sandbox [args]  run the agent; args go to pi (e.g. --perm plan)
# Own config is mounted read-only; to edit skills/prompts/config, run a second
# pi-sandbox from ~/Code/pi-sandbox and /reload the first one.

set -euo pipefail

ENV_FLAGS=()
if [ -f "$HOME/Code/pi-sandbox/.env" ]; then
  ENV_FLAGS=(--env-file "$HOME/Code/pi-sandbox/.env")
fi

# Fine-grained PAT, public repos read-only: gh can read PRs, never write; post reviews from the host
if [ -f "$HOME/.config/pi-sandbox/gh-token" ]; then
  GH_TOKEN=$(<"$HOME/.config/pi-sandbox/gh-token")
  export GH_TOKEN
  ENV_FLAGS+=(-e GH_TOKEN)
fi

mkdir -p "$HOME/Downloads/isos" "$HOME/Code/pi-sandbox/skills"

FLAGS=(
  --rm
  --network pasta:--map-host-loopback,169.254.1.2
  -it
  --cap-drop=ALL
  # bwrap (pi-permission-modes OS sandbox) maps uid 0 into a user namespace; kernel requires SETFCAP for that
  --cap-add=SETFCAP
  # bwrap mounts a fresh /proc per command; kernel refuses that while podman masks /proc paths
  --security-opt "unmask=/proc/*"
  --security-opt no-new-privileges
  "${ENV_FLAGS[@]}"
  -e "GOOGLE_CLOUD_LOCATION=${GOOGLE_CLOUD_LOCATION:-global}"
  -e GOOGLE_APPLICATION_CREDENTIALS=/root/adc.json
  -e PONYTAIL_DEFAULT_MODE=off
  -v "$HOME/.config/gcloud/application_default_credentials.json:/root/adc.json:ro"
  -v "$PWD:/workspace"
  # TODO(parallel agents): this volume is shared by every instance, so concurrent
  # agents can clash on sessions/auth. Make the name per-project, e.g.
  # "pi-agent-home-$(basename "$PWD")" (trade-off: separate sessions/login per project).
  -v "pi-agent-home:/root/.pi/agent"
  -v "$HOME/Code/pi-sandbox/pi-settings.json:/root/.pi/agent/settings.json:ro"
  -v "$HOME/Code/pi-sandbox/pi-models.json:/root/.pi/agent/models.json:ro"
  -v "$HOME/Code/pi-sandbox/web-search.json:/root/.pi/agent/web-search.json:ro"
  -v "$HOME/Code/pi-sandbox/permission-mode.json:/root/.pi/agent/permission-mode/permission-mode.json:ro"
  -v "$HOME/Code/pi-sandbox/APPEND_SYSTEM.md:/root/.pi/agent/APPEND_SYSTEM.md:ro"
  -v "$HOME/Code/pi-sandbox/i-have-adhd.json:/root/.pi/agent/i-have-adhd.json:ro"
  -v "$HOME/Code/pi-sandbox/skills-custom:/root/.pi/agent/skills-custom:ro"
  -v "$HOME/Code/pi-sandbox/skills:/root/.pi/agent/skills:ro"
  -v "$HOME/Code/pi-sandbox/prompts:/root/.pi/agent/prompts:ro"
  -v "$HOME/Code/pi-sandbox/extensions-custom:/root/.pi/agent/extensions-custom:ro"
  -v "$HOME/Downloads/isos:/root/Downloads/isos"
  -v "$HOME/Code/pi-sandbox/client.conf:/root/.config/openqa/client.conf:ro"
)

podman run "${FLAGS[@]}" pi-sandbox --approve "$@"
