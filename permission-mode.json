{
  "$schema": "https://raw.githubusercontent.com/wynainfo/pi-permission-modes/main/schemas/permission-mode.schema.json",
  "modes": {
    "default": {
      "permission": {
        "external_directory": { "*": "ask", "/root/.pi/agent/skills*": "allow", "/root/.pi/agent/git/*": "allow" }
      },
      "sandbox": {
        "allowWrite": [".", "/tmp", "/root/.pi/agent/git"]
      }
    },
    "plan": {
      "permission": {
        "external_directory": { "*": "ask", "/root/.pi/agent/skills*": "allow", "/root/.pi/agent/git/*": "allow" }
      },
      "sandbox": {
        "allowWrite": [
          ".",
          "/tmp",
          "/usr/local/lib/node_modules/@earendil-works/pi-coding-agent",
          "/root/.pi/agent/skills",
          "/root/.pi/agent/skills-custom",
          "/root/.pi/agent/git"
        ],
        "network": {
          "allowedDomains": [
            "npmjs.org",
            "*.npmjs.org",
            "registry.npmjs.org",
            "registry.yarnpkg.com",
            "pypi.org",
            "*.pypi.org",
            "github.com",
            "*.github.com",
            "api.github.com",
            "raw.githubusercontent.com",
            "openqa.suse.de",
            "openqa.opensuse.org",
            "example.com"
          ],
          "deniedDomains": []
        }
      }
    }
  }
}
