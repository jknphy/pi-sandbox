{
  "$schema": "https://raw.githubusercontent.com/wynainfo/pi-permission-modes/main/schemas/permission-mode.schema.json",
  "modes": {
    "default": {
      "permission": {
        "external_directory": {
          "*": "ask",
          "/root/.pi/agent/skills*": "allow",
          "/root/.pi/agent/git/*": "allow"
        },
        "path": {
          "*": "allow",
          "*.config/openqa*": "deny",
          "*adc.json*": "deny",
          "*application_default_credentials*": "deny",
          "*.pi/agent/auth.json*": "deny",
          "*.pi/agent/oauth.json*": "deny"
        },
        "bash": {
          "*": "ask",
          "*gh auth token*": "deny",
          "*gh auth status*": "deny",
          "*credential fill*": "deny",
          "*MOJO_CLIENT_DEBUG*": "deny",
          "*--apikey*": "deny",
          "*--apisecret*": "deny",
          "*-H*uthorization*": "deny",
          "*--header*uthorization*": "deny",
          "*GH_TOKEN*": "deny",
          "env": "deny",
          "printenv*": "deny"
        }
      },
      "sandbox": {
        "allowWrite": [
          ".",
          "/tmp",
          "/root/.pi/agent/git"
        ]
      }
    },
    "plan": {
      "permission": {
        "external_directory": {
          "*": "ask",
          "/root/.pi/agent/skills*": "allow",
          "/root/.pi/agent/git/*": "allow"
        },
        "path": {
          "*": "allow",
          "*.config/openqa*": "deny",
          "*adc.json*": "deny",
          "*application_default_credentials*": "deny",
          "*.pi/agent/auth.json*": "deny",
          "*.pi/agent/oauth.json*": "deny"
        },
        "bash": {
          "*": "allow",
          "*gh auth token*": "deny",
          "*gh auth status*": "deny",
          "*credential fill*": "deny",
          "*MOJO_CLIENT_DEBUG*": "deny",
          "*--apikey*": "deny",
          "*--apisecret*": "deny",
          "*-H*uthorization*": "deny",
          "*--header*uthorization*": "deny",
          "*GH_TOKEN*": "deny",
          "env": "deny",
          "printenv*": "deny"
        }
      },
      "sandbox": {
        "allowWrite": [
          ".",
          "/tmp",
          "/usr/local/lib/node_modules/@earendil-works/pi-coding-agent",
          "/root/.pi/agent/skills",
          "/root/.pi/agent/skills-custom",
          "/root/.pi/agent/git"
        ],
        "network": {
          "allowedDomains": [
            "npmjs.org",
            "*.npmjs.org",
            "registry.npmjs.org",
            "registry.yarnpkg.com",
            "pypi.org",
            "*.pypi.org",
            "github.com",
            "*.github.com",
            "api.github.com",
            "raw.githubusercontent.com",
            "openqa.suse.de",
            "openqa.opensuse.org",
            "example.com"
          ],
          "deniedDomains": []
        }
      }
    },
    "build": {
      "permission": {
        "path": {
          "*": "allow",
          "*.config/openqa*": "deny",
          "*adc.json*": "deny",
          "*application_default_credentials*": "deny",
          "*.pi/agent/auth.json*": "deny",
          "*.pi/agent/oauth.json*": "deny"
        },
        "bash": {
          "*": "allow",
          "*gh auth token*": "deny",
          "*gh auth status*": "deny",
          "*credential fill*": "deny",
          "*MOJO_CLIENT_DEBUG*": "deny",
          "*--apikey*": "deny",
          "*--apisecret*": "deny",
          "*-H*uthorization*": "deny",
          "*--header*uthorization*": "deny",
          "*GH_TOKEN*": "deny",
          "env": "deny",
          "printenv*": "deny"
        }
      }
    }
  }
}
