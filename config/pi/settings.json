{
  "defaultProvider": "google-vertex",
  "defaultModel": "gemini-3.8-flash",
  "enabledModels": [
    "gemini-3.1-pro-preview",
    "gemini-3.8-flash",
    "claude-sonnet-5-5",
    "claude-haiku-5-5",
    "claude-opus-5-5",
    "ollama/default:latest",
    "llamacpp/Qwen3-4B-Instruct-2507-Q4_K_M"
  ],
  "packages": [
    "npm:@twogiants/pi-anthropic-vertex",
    "npm:pi-permission-modes",
    "npm:pi-web-access",
    "git:github.com/ayghri/i-have-adhd",
    {
      "source": "npm:@dietrichgebert/ponytail",
      "skills": ["skills/ponytail"]
    },
    "git:github.com/os-autoinst/openQA-skill"
  ],
  "extensions": [
    "/root/.pi/agent/extensions-custom"
  ],
  "skills": [
    "/root/.pi/agent/skills-custom"
  ],
  "compaction": {
    "enabled": true,
    "reserveTokens": 8000,
    "keepRecentTokens": 12000
  },
  "defaultProjectTrust": "always",
  "tuiMode": "fullscreen",
  "externalEditor": "vim",
  "enableInstallTelemetry": false,
  "lastChangelogVersion": "1.2.0",
  "hideThinkingBlock": true
}
